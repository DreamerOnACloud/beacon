---
// No `prerender` export — this page uses Astro's default: prerendered once,
// at build time. Every visitor gets the exact same HTML until the site is
// rebuilt and redeployed.
const renderedAt = new Date().toISOString();
const token = Math.random().toString(36).slice(2, 8);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Flyer</title>
		<style>
			body {
				margin: 0;
				padding: 1rem;
				font-family: system-ui, sans-serif;
				background: #1a1a2e;
				color: #e0e0e0;
			}
			.label {
				margin: 0 0 0.5rem;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				color: #8888aa;
			}
			.value {
				margin: 0;
				font-size: 1.1rem;
				font-variant-numeric: tabular-nums;
			}
			.token {
				margin: 0.5rem 0 0;
				font-family: ui-monospace, monospace;
				color: #8888aa;
			}
		</style>
	</head>
	<body>
		<p class="label">Flyer — photocopied once, in advance</p>
		<p class="value">Printed at: {renderedAt}</p>
		<p class="token">Copy #: {token}</p>
	</body>
</html>
