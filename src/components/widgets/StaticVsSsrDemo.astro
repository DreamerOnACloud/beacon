---
import Playground from '../Playground.astro';
---

<Playground label="Try it — reload each pane and compare">
	<div class="ssr-demo" data-ssr-demo>
		<div class="pane">
			<div class="pane-header">
				<span>Static page</span>
				<button type="button" data-target="static">Reload</button>
			</div>
			<iframe title="Statically rendered page" data-frame="static" src="/demos/static-render/"></iframe>
		</div>
		<div class="pane">
			<div class="pane-header">
				<span>Server-rendered page</span>
				<button type="button" data-target="ssr">Reload</button>
			</div>
			<iframe title="Server-rendered page" data-frame="ssr" src="/demos/ssr-render/"></iframe>
		</div>
	</div>
</Playground>

<style>
	.ssr-demo {
		display: grid;
		gap: 1rem;
		grid-template-columns: 1fr 1fr;
	}

	@media (max-width: 640px) {
		.ssr-demo {
			grid-template-columns: 1fr;
		}
	}

	.pane {
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.375rem;
		overflow: hidden;
	}

	.pane-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0.75rem;
		background-color: var(--sl-color-gray-5);
		font-size: var(--sl-text-sm);
	}

	.pane-header button {
		padding: 0.125rem 0.625rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.25rem;
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-text);
		font: inherit;
		font-size: var(--sl-text-xs);
		cursor: pointer;
	}

	.pane iframe {
		display: block;
		width: 100%;
		height: 8rem;
		border: none;
	}
</style>

<script>
	function initDemo(root: HTMLElement) {
		root.querySelectorAll<HTMLButtonElement>('button[data-target]').forEach((button) => {
			button.addEventListener('click', () => {
				const frame = root.querySelector<HTMLIFrameElement>(`iframe[data-frame="${button.dataset.target}"]`);
				if (!frame) return;
				// Cache-bust so the reload is a genuine new request, not a
				// browser-cache hit — otherwise even the SSR pane could
				// appear "static" for the wrong reason.
				const url = new URL(frame.src, location.href);
				url.searchParams.set('_', Date.now().toString());
				frame.src = url.toString();
			});
		});
	}

	document.querySelectorAll<HTMLElement>('[data-ssr-demo]').forEach(initDemo);
</script>
